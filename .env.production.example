# Shared production settings for both supported deployment paths.
#
# Quick path (server-side build, no application registry):
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f compose.production.yml up -d --build
#
# Kamal/GHCR path:
#   cp .env.production.example .env.production
#   bin/kamal -d production setup
#
# Never commit .env.production.

# --- Runtime and public endpoint ---
PORT=3000
DATABASE_PATH=/data/reviews.db
PROXY_HOST=reviewer.example.com

# --- Repository provider ---
# Choose "github" or "gitlab". Fill only the matching provider block.
REPO_PROVIDER=github

# GitHub App credentials. Base64-encoded PEM is the least fragile private-key format:
#   base64 < your-app.private-key.pem | tr -d '\n'
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTiBSU0EgUF...base64...
GITHUB_WEBHOOK_SECRET=generate-a-long-random-string

# Normal GitHub login(s) selected as PR reviewers. A GitHub App bot cannot be
# selected as a reviewer. Use one login or a comma-separated list.
REVIEWER_LOGIN=your-reviewer-user

# Mandatory GitHub runtime scope. Owner entries allow every repository owned by
# that account. Exact repositories supplement the owner list. Values are matched
# case-insensitively; at least one of these two variables must contain a value.
GITHUB_ALLOWED_OWNERS=your-github-org
#GITHUB_ALLOWED_REPOSITORIES=your-github-org/repo-a,your-user/repo-b

# GitLab project/group access token (scopes: api, read_repository). The bot is
# triggered when added as a reviewer or assignee.
#GITLAB_TOKEN=glpat-xxx
#GITLAB_WEBHOOK_SECRET=generate-a-long-random-string
#GITLAB_API_URL=https://gitlab.com

# --- AI provider ---
# Choose "claude" or "codex".
AI_PROVIDER=codex

# Claude subscription auth. Generate with `claude setup-token`. Never set
# ANTHROPIC_API_KEY alongside it because the API key changes the billing path.
#CLAUDE_CODE_OAUTH_TOKEN=claude_oauth_xxx
#CLAUDE_MODEL=claude-sonnet-4-6

# Codex can use an API key/access token, or the persisted CLI login under
# /home/node/.codex. CODEX_API_KEY wins over CODEX_ACCESS_TOKEN when both exist.
#CODEX_API_KEY=sk-...
#CODEX_ACCESS_TOKEN=codex_access_token
#CODEX_MODEL=gpt-5.6-terra
#CODEX_REASONING_EFFORT=medium
#CODEX_WEB_SEARCH_MODE=disabled
#CODEX_BASE_URL=https://api.openai.com/v1

# Provider execution budget. The global default is 1800 seconds even when this is
# omitted. A provider-specific value always overrides the global value. Values must
# be positive safe integers; zero never means "unbounded".
REVIEW_TIMEOUT_SECONDS=1800
#CLAUDE_TIMEOUT_SECONDS=1800
#CODEX_TIMEOUT_SECONDS=1800

# --- Review behavior ---
BOT_NAME="Alátùńwò AI"
DEEP_REVIEW=false
DEEP_REVIEW_MAX_TURNS=8

# --- Kamal/GHCR only ---
# Compose ignores these values. Kamal builds natively on WEB_HOSTS and pushes the
# image to GHCR before deployment.
IMAGE=your-ghcr-namespace/ai-code-reviewer
KAMAL_REGISTRY_USERNAME=your-github-username
KAMAL_REGISTRY_PASSWORD=ghp_xxx
WEB_HOSTS=1.2.3.4
SSH_USER=deploy
# Persistent host directory for Codex CLI auth in the Kamal container. Create it
# as UID/GID 1000 before the first deployment.
#CODEX_STATE_PATH=/home/deploy/.ai-code-reviewer/codex
