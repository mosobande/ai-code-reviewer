# --- Repository provider ---
# Which code host to talk to. "github" (default) or "gitlab". One host per deploy;
# fill in only that host's block below. The webhook lands on /api/<provider>/webhooks.
REPO_PROVIDER=github

# --- GitHub App (REPO_PROVIDER=github) ---
# Settings -> Developer settings -> GitHub Apps -> your app.
GITHUB_APP_ID=123456
# Paste the .pem on one line, with real newlines escaped as \n
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# A long random string; must match the "Webhook secret" set on the GitHub App
GITHUB_WEBHOOK_SECRET=generate-a-long-random-string
# The GitHub login that, when requested as a reviewer, triggers a review. Use your
# own username, or a dedicated machine-user account. Single value or comma-separated.
REVIEWER_LOGIN=your-github-username
# Mandatory runtime scope. Owner entries allow all repositories under that owner;
# exact repositories supplement the owner list. At least one must contain a value.
GITHUB_ALLOWED_OWNERS=your-github-org
#GITHUB_ALLOWED_REPOSITORIES=your-github-org/repo-a,your-user/repo-b
# Optional exact repositories reviewed automatically on open, ready, and push.
#GITHUB_AUTO_REVIEW_REPOSITORIES=your-github-org/repo-a

# --- GitLab (REPO_PROVIDER=gitlab) ---
# A Project or Group access token (scopes: api, read_repository). Its bot user is the
# account that, when added as a reviewer OR assignee on an MR, triggers a review — the
# bot identity is resolved from the token, so there's no REVIEWER_LOGIN on GitLab.
#GITLAB_TOKEN=glpat-xxx
# Exact projects admitted for GitLab reviews.
#REPOSITORY_ALLOWED_REPOSITORIES=your-group/your-project
# Standard Webhooks signing token (GitLab 19.1+), not X-Gitlab-Token.
#GITLAB_WEBHOOK_SECRET=whsec_replace-with-signing-token
#GITLAB_WEBHOOK_MAX_AGE_SECONDS=300
# Map each exact allowed project to its configured external status check ID.
#GITLAB_EXTERNAL_STATUS_CHECK_IDS_JSON='{"your-group/your-project":17}'
# API base; defaults to https://gitlab.com. Point at your host for self-managed GitLab.
#GITLAB_API_URL=https://gitlab.com

# --- AI provider ---
# Which review engine to drive. "claude" (the Claude Code CLI) is the default;
# "codex" drives the official @openai/codex-sdk.
AI_PROVIDER=claude

# --- Claude subscription auth ---
# Generate with: claude setup-token   (valid ~1 year; bills to your Pro/Max plan)
CLAUDE_CODE_OAUTH_TOKEN=claude_oauth_xxx
# IMPORTANT: do NOT set ANTHROPIC_API_KEY here — it would take precedence and
# move usage onto metered API billing instead of your subscription.

CLAUDE_MODEL=claude-sonnet-4-6

# --- Codex SDK auth/config (AI_PROVIDER=codex) ---
# @openai/codex-sdk is installed as an app dependency. CODEX_API_KEY takes precedence
# when set. Otherwise CODEX_ACCESS_TOKEN can provide trusted automation
# (OAuth-style subscription/workspace identity), analogous operationally to
# providing CLAUDE_CODE_OAUTH_TOKEN for Claude. If neither is set, Codex falls
# back to its default CLI auth/config.
#CODEX_MODEL=gpt-5.5
#CODEX_REASONING_EFFORT=medium
#CODEX_WEB_SEARCH_MODE=disabled
#CODEX_BASE_URL=https://api.openai.com/v1
#CODEX_API_KEY=sk-...
#CODEX_ACCESS_TOKEN=codex_access_token

# --- Optional separate review model gateway ---
# Run the gateway as its own process; see docs/model-gateway.md. Set these only
# on the reviewer. Remove direct Claude/Codex credentials from this process.
#MODEL_GATEWAY_SOCKET_PATH=/absolute/path/to/.acr/model-gateway.sock
#MODEL_GATEWAY_ANTHROPIC_PROFILE=review
#MODEL_GATEWAY_OPENAI_PROFILE=review
PORT=3000

# --- Review authority ---
# A target-branch .acr.yml can select review.approval for one repository.
ACR_APPROVAL_MODE=human
ACR_REVIEW_ADMISSION_ENABLED=true
ACR_REVIEW_TERMINAL_SUCCESS_ENABLED=true

# --- Provider execution deadline ---
# One shared wall-clock budget for the initial attempt and its automatic retry.
# Provider values override the global value. Positive safe integers only; zero does
# not disable the deadline. The global default is 1800 seconds when omitted.
REVIEW_TIMEOUT_SECONDS=1800
#CLAUDE_TIMEOUT_SECONDS=1800
#CODEX_TIMEOUT_SECONDS=1800

# Display name shown in the review header ("🤖 **<BOT_NAME> review**"). Defaults
# to "Alátùńwò AI" — override to rebrand.
BOT_NAME="Alátùńwò AI"

# --- Review store (SQLite) ---
# Where the idempotency + audit-log database lives. Defaults to ./data/reviews.db.
# In a container, point this at a mounted volume so it survives redeploys
# (config/deploy.yml sets it to /data/reviews.db).
DATABASE_PATH=./data/reviews.db

# --- Deep reviews (optional) ---
# When "true", the service clones the PR/MR head and lets the model open surrounding
# files (read-only tools only — no shell/write). Needs git on the host and read access
# to repo contents (GitHub App Contents: Read / GitLab token read_repository).
# Enabled by default. Set DEEP_REVIEW=false for diff-only reviews; a PR/MR labelled
# "deep-review" still gets a deep
# review. DEEP_REVIEW_MAX_TURNS is the turn budget per deep review; diff-only reviews
# always use a single pass.
DEEP_REVIEW=true
DEEP_REVIEW_MAX_TURNS=8
